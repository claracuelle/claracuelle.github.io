---
import Base from "../layouts/Base.astro";

import Icon from "/public/icons/icon-clara-cuelle.svg";
import Close from "/public/icons/icon-close.svg";
import Eye from "/public/icons/icon-eye.svg";
---

<Base>
  <main
    class="relative isolate flex flex-col justify-between items-center h-screen overflow-hidden bg-beige lg:items-start p-8 lg:p-20"
  >
    <Icon
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[200vw] max-w-none -translate-x-1/2 -translate-y-1/2 text-blue opacity-[0.02] lg:w-[115vw]"
    />

    <nav class="flex justify-between items-center w-full">
      <Icon class="text-blue aspect-48/40 w-12 lg:w-15" />
      <ul class="hidden lg:flex gap-6">
        <li>
          <a href="/documents/cv-clara-cuelle.pdf" class="btn btn-1 lg:btn--lg">
            <Eye aria-hidden="true" class="size-4" />
            CV
          </a>
        </li>
        <li>
          <a
            href="/documents/portfolio-clara-cuelle.pdf"
            class="btn btn-1 lg:btn--lg"
          >
            <Eye aria-hidden="true" class="size-4" />
            Portfolio
          </a>
        </li>
      </ul>
    </nav>
    <section
      class="flex flex-col justify-center items-center lg:items-start **:text-center"
    >
      <h1 class="block text-huge lg:text-huge--lg mb-2">Clara Cuelle</h1>
      <h2 class="block text-body lg:text-body--lg mb-8 lg:mb-0">
        Directrice artistique digitale & UX/UI Designer
      </h2>
      <div class="flex lg:hidden flex-col gap-2">
        <ul class="flex lg:hidden gap-x-3 justify-center items-center">
          <li class="badge badge-1">UX/UI design</li>
          <li class="badge badge-1">Communication</li>
        </ul>
        <ul class="flex lg:hidden gap-x-3 justify-center items-center">
          <li class="badge badge-1">Photographie</li>
          <li class="badge badge-1">Branding</li>
        </ul>
      </div>
    </section>
    <section class="hidden lg:flex justify-between items-center w-full">
      <ul class="flex gap-6 justify-center items-center">
        <li class="badge--lg badge-1">UX/UI design</li>
        <li class="badge--lg badge-1">Communication</li>
        <li class="badge--lg badge-1">Photographie</li>
        <li class="badge--lg badge-1">Branding</li>
      </ul>
      <button
        command="show-modal"
        commandfor="panel-links"
        class="btn btn--lg btn-2"
        type="button">Mes liens</button
      >
    </section>
    <nav class="flex w-full lg:hidden justify-center items-center">
      <ul class="flex gap-6 justify-center items-center">
        <li>
          <button
            command="show-modal"
            commandfor="panel-pdf"
            class="btn btn-1"
            type="button">PDF</button
          >
        </li>
        <li>
          <button
            command="show-modal"
            commandfor="panel-links"
            class="btn btn-2"
            type="button">Mes liens</button
          >
        </li>
      </ul>
    </nav>

  </main>

  <dialog id="panel-pdf" class="panel">
    <div class="flex h-full flex-col">
      <header class="flex items-start justify-between">
        <Icon class="text-blue aspect-48/40 w-12 lg:w-15" />
        <button
          command="close"
          commandfor="panel-pdf"
          class="text-ink rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
          type="button"
          aria-label="Fermer le panneau PDF"
        >
          <Close aria-hidden="true" class="size-6 lg:size-8" />
        </button>
      </header>

      <nav class="mt-auto md:self-end md:text-right" aria-label="Documents PDF">
        <ul>
          <li>
            <a
              href="/documents/cv-clara-cuelle.pdf"
              class="link-huge rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
            >CV</a>
          </li>
          <li>
            <a
              href="/documents/portfolio-clara-cuelle.pdf"
              class="link-huge rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
            >Portfolio</a>
          </li>
        </ul>
      </nav>
    </div>
  </dialog>

  <dialog id="panel-links" class="panel">
    <div class="flex h-full flex-col">
      <header class="flex items-start justify-between">
        <Icon class="text-blue aspect-48/40 w-12 lg:w-15" />
        <button
          command="close"
          commandfor="panel-links"
          class="text-ink rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
          type="button"
          aria-label="Fermer le panneau Mes liens"
        >
          <Close aria-hidden="true" class="size-6 lg:size-8" />
        </button>
      </header>

      <nav class="mt-auto md:self-end md:text-right" aria-label="Réseaux sociaux">
        <ul class="flex flex-col gap-[10px]">
          <li>
            <a
              href="https://www.instagram.com/claracuelle.studio"
              class="link-huge rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
              target="_blank"
              rel="noopener noreferrer"
            >Instagram</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/clara-cuelle/"
              class="link-huge rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
              target="_blank"
              rel="noopener noreferrer"
            >LinkedIn</a>
          </li>
          <li>
            <a
              href="https://www.behance.net/claracuelle_studio"
              class="link-huge rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
              target="_blank"
              rel="noopener noreferrer"
            >Behance</a>
          </li>
        </ul>
      </nav>
    </div>
  </dialog>
</Base>
